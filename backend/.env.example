# EmailJS credentials — https://dashboard.emailjs.com
# Sending happens server-side, so the PRIVATE key stays here and never ships to
# the browser. In EmailJS: Account → Security → enable
# "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=          # Email Services → your service ID
EMAILJS_TEMPLATE_ID=         # Email Templates → your template ID
EMAILJS_PUBLIC_KEY=          # Account → General → Public Key
EMAILJS_PRIVATE_KEY=         # Account → General → Private Key (keep secret!)

# The message recipient (your inbox) is configured on the EmailJS template
# itself ("To Email"), not here.

# Allowed frontend origin(s) for CORS. Comma-separate multiple origins.
# Production example: https://ghazaliray.com,https://www.ghazaliray.com
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
PORT=8080
